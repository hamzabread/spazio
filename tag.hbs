{{!< default}}

{{#tag}}
<div class="sc-tag-page">
    {{!-- Hero — same shell as page-events.hbs (.sc-contact-hero) --}}
    <section class="sc-contact-hero" aria-labelledby="sc-tag-hero-title">
        <div class="sc-contact-hero-inner gh-container">
            <span class="sc-contact-hero-chip">{{t "Tag"}}</span>
            <h1 id="sc-tag-hero-title">{{name}}</h1>
            {{#if description}}
            <p>{{description}}</p>
            {{else}}
            <p>{{plural ../pagination.total empty=(t "No Posts") singular=(t "% Post") plural=(t "% Posts")}}</p>
            {{/if}}
        </div>
    </section>
</div>
{{/tag}}

<main class="gh-archive-page gh-container sc-tag-archive">
    {{>posts-layout}}

    {{^if @member.paid}}
    {{!-- Ad Unit #2400932 - Tag Page Feed Bottom --}}
    <div id="frame" style="width: 100%;margin: auto;background: rgba(0, 0, 0, 0.50);position: relative; z-index: 99998;">
          <iframe data-aa='2400932' src='//acceptable.a-ads.com/2400932/?size=Adaptive'
                            style='border:0; padding:0; width:70%; height:auto; overflow:hidden;display: block;margin: auto'></iframe>
    </div>
    {{/if}}
</main>
