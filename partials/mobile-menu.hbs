<div class="gh-overlay">
    <div class="gh-mobile-menu sc-mobile-menu">
        <div class="gh-mobile-menu__header sc-mm-header">
            <a class="sc-mm-brand" href="{{@site.url}}" aria-label="{{@site.title}}">
                <span class="sc-mm-brand-spazio">Spazio</span><span class="sc-mm-brand-crypto">Crypto</span>
            </a>
            <button class="gh-mobile-menu__close-btn sc-mm-close" aria-label="{{t "Close mobile menu button"}}">
                {{> "icons/close-icon"}}
            </button>
        </div>

        <div class="gh-mobile-menu-main sc-mm-main">
            <nav class="sc-mm-nav" aria-label="{{t "Mobile primary navigation"}}">
                <ul class="sc-mm-list">
                    <li class="sc-mm-item">
                        <a class="sc-mm-link" href="{{@site.url}}/tag/news/">
                            <span class="sc-mm-link-label">{{t "News"}}</span>
                            <svg class="sc-mm-caret" width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true"><path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>
                    </li>

                    <li class="sc-mm-item sc-mm-has-sub" data-sc-mm-accordion>
                        <button type="button" class="sc-mm-link sc-mm-link-btn" aria-expanded="false">
                            <span class="sc-mm-link-icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 14 14" fill="none">
                                    <path d="M12.8327 4.08301L7.87435 9.04134L4.95768 6.12467L1.16602 9.91634" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M9.33398 4.08301H12.834V7.58301" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                            <span class="sc-mm-link-label">{{t "Markets"}}</span>
                            <svg class="sc-mm-caret" width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true"><path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <ul class="sc-mm-sublist">
                            <li><a href="{{@site.url}}/companies/">{{t "Companies"}}</a></li>
                            <li><a href="{{@site.url}}/projects/">{{t "Projects"}}</a></li>
                            <li><a href="{{@site.url}}/exchanges/">{{t "Exchanges"}}</a></li>
                            <li><a href="{{@site.url}}/submit/" class="sc-mm-sub-cta">{{t "Submit Company"}}</a></li>
                        </ul>
                    </li>

                    <li class="sc-mm-item">
                        <a class="sc-mm-link" href="{{@site.url}}/tag/product/">
                            <span class="sc-mm-link-icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 14 14" fill="none">
                                    <path d="M11.083 1.75H2.917A1.17 1.17 0 0 0 1.75 2.917v8.166A1.17 1.17 0 0 0 2.917 12.25h8.166a1.17 1.17 0 0 0 1.167-1.167V2.917A1.17 1.17 0 0 0 11.083 1.75Z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M5.25 4.667h4.083M4.666 7h3.5M6.416 9.333h2.917" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                            <span class="sc-mm-link-label">{{t "Product"}}</span>
                            <svg class="sc-mm-caret" width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true"><path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>
                    </li>

                    <li class="sc-mm-item">
                        <a class="sc-mm-link" href="{{@site.url}}/tag/ai/">
                            <span class="sc-mm-link-icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 14 14" fill="none">
                                    <path d="m6.72 1.38-.92 3.58a1.5 1.5 0 0 1-1.04 1.05L1.18 6.93a.21.21 0 0 0 0 .4l3.58.92a1.5 1.5 0 0 1 1.04 1.05l.92 3.58a.21.21 0 0 0 .4 0l.92-3.58a1.5 1.5 0 0 1 1.04-1.05l3.58-.92a.21.21 0 0 0 0-.4L9.08 5.97a1.5 1.5 0 0 1-1.04-1.05L7.12 1.34a.21.21 0 0 0-.4.04Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
                                    <path d="M11.666 1.75v2.333M12.833 2.917H10.5M2.334 9.917v1.166M2.917 10.5H1.75" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                            <span class="sc-mm-link-label">{{t "AI Insights"}}</span>
                        </a>
                    </li>

                    <li class="sc-mm-item sc-mm-theme-row">
                        <div class="sc-mm-link sc-mm-link--static">
                            <span class="sc-mm-link-label">{{t "Theme"}}</span>
                            <button class="gh-dark-mode-toggle-btn sc-mm-theme-toggle" aria-label="{{t "Dark mode toggle button"}}">
                                {{>icons/sun}}
                                {{>icons/moon}}
                            </button>
                        </div>
                    </li>
                </ul>

                <div class="sc-mm-ctas">
                    <a class="sc-mm-cta sc-mm-cta--ghost" href="{{@site.url}}/post-a-job/">{{t "Post a Job"}}</a>
                    <a class="sc-mm-cta sc-mm-cta--filled" href="{{@site.url}}/list-your-company/">{{t "List Your Company"}}</a>
                </div>

                {{#if @site.members_enabled}}
                <div class="sc-mm-members">
                    {{#unless @member}}
                        {{#unless @site.members_invite_only}}
                            <a class="sc-mm-signin" href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
                            <a class="sc-mm-join" href="/signup/">{{t "Join the 10k+ Subscribers"}}</a>
                        {{else}}
                            <a class="sc-mm-signin" href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
                        {{/unless}}
                    {{else}}
                        <a class="sc-mm-signin" href="#/portal/account" data-portal="account">{{t "Account"}}</a>
                    {{/unless}}
                </div>
                {{/if}}

                {{!-- Optional social row — keep but compact --}}
                <ul class="sc-mm-socials">
                    {{#if @site.facebook}}
                    <li><a class="gh-social-icon-link" href="{{facebook_url}}" target="_blank" rel="noopener noreferrer" aria-label="{{@site.title}} {{t "Facebook"}}">{{> "icons/facebook"}}</a></li>
                    {{/if}}
                    <li><a class="gh-social-icon-link" href="{{@custom.telegram_link}}" target="_blank" rel="noopener noreferrer" aria-label="{{@site.title}} {{t "Telegram"}}">{{> "icons/telegram"}}</a></li>
                    <li><a class="gh-social-icon-link" href="{{@custom.insta_link}}" target="_blank" rel="noopener noreferrer" aria-label="{{@site.title}} {{t "Instagram"}}">{{> "icons/instagram"}}</a></li>
                    {{#if @site.twitter}}
                    <li><a class="gh-social-icon-link" href="{{twitter_url}}" target="_blank" rel="noopener noreferrer" aria-label="{{@site.title}} {{t "Twitter"}}">{{> "icons/twitter"}}</a></li>
                    {{/if}}
                </ul>

                <p class="sc-mm-copy">
                    <span>© {{date format="YYYY"}} {{@site.title}}</span>
                    <span>{{t "ALL RIGHTS RESERVED"}}.</span>
                </p>
            </nav>
        </div>
    </div>
</div>

<style>
  /* --- Spazio mobile menu (hardcoded nav + accordion + theme pill) --- */
  .sc-mobile-menu {
    background: var(--color-background-main, #fff);
    color: var(--color-main, #1a1a1a);
    width: 100%; 
    display: flex; flex-direction: column;
    height: 100dvh;
  }
  .sc-mm-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--sc-border, #efeff1);
    background: var(--sc-bg, #f8f9fa);
  }
  /* Text-based brand (replaces the SVG logo on mobile menu).
     Mirrors the desktop header's "Spazio" + orange "Crypto" treatment. */
  .sc-mm-brand {
    display: inline-flex; align-items: center;
    font-family: "Helvetica Now Display", "Helvetica Neue", Arial, sans-serif;
    font-weight: 700; font-size: 22px; line-height: 1;
    text-decoration: none;
    color: var(--color-main, #1a1a1a);
    letter-spacing: -0.2px;
  }
  .sc-mm-brand-spazio { color: var(--color-main, #1a1a1a); }
  .sc-mm-brand-crypto { color: var(--sc-accent, #f18f20); }
  /* Close button — explicitly pinned to the right edge of the header */
  .gh-mobile-menu__close-btn.sc-mm-close {
    margin-left: auto;
    background: transparent; border: 0; padding: 6px;
    color: var(--color-main, #1a1a1a); cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
  }

  .sc-mm-main {
    flex: 1; overflow-y: auto;
    padding: 4px 0 24px;
  }

  .sc-mm-nav { display: flex; flex-direction: column; }
  .sc-mm-list { list-style: none; padding: 0; margin: 0; }
  .sc-mm-item {
    border-bottom: 1px solid var(--sc-border, #f0f0f0);
  }
  .sc-mm-link,
  .sc-mm-link-btn {
    display: flex; align-items: center; gap: 10px;
    width: 100%; padding: 16px 20px;
    color: var(--color-main, #1a1a1a);
    text-decoration: none; background: transparent; border: 0;
    font-size: 16px; font-weight: 500; line-height: 1;
    cursor: pointer; text-align: left;
  }
  .sc-mm-link:hover,
  .sc-mm-link-btn:hover { color: var(--sc-accent, #f18f20); }
  .sc-mm-link-icon { display: inline-flex; }
  .sc-mm-link-label { flex: 1; }
  .sc-mm-caret {
    transition: transform 0.2s ease;
    color: var(--sc-text-muted, #6a7282);
  }
  .sc-mm-has-sub[data-sc-mm-accordion].is-open > .sc-mm-link-btn {
    color: var(--sc-accent, #f18f20);
    background: rgba(241, 143, 32, 0.06);
  }
  .sc-mm-has-sub[data-sc-mm-accordion].is-open > .sc-mm-link-btn .sc-mm-caret {
    transform: rotate(180deg);
    color: var(--sc-accent, #f18f20);
  }

  .sc-mm-sublist {
    list-style: none; padding: 0; margin: 0;
    overflow: hidden; max-height: 0;
    transition: max-height 0.25s ease;
  }
  .sc-mm-has-sub[data-sc-mm-accordion].is-open .sc-mm-sublist { max-height: 400px; }
  .sc-mm-sublist li { border-top: 1px solid var(--sc-border, #f0f0f0); }
  .sc-mm-sublist a {
    display: block; padding: 14px 20px 14px 46px;
    color: var(--color-main, #1a1a1a);
    text-decoration: none; font-size: 15px;
  }
  .sc-mm-sublist a:hover { color: var(--sc-accent, #f18f20); }
  .sc-mm-sublist a.sc-mm-sub-cta {
    color: var(--sc-accent, #f18f20);
    font-weight: 600;
  }

  .sc-mm-theme-row .sc-mm-link--static {
    cursor: default;
  }
  .sc-mm-theme-toggle {
    margin-left: auto;
    background: var(--sc-card-bg, #fff);
    border: 1px solid var(--sc-border, #e3e6ea);
    border-radius: 999px; padding: 4px;
    display: inline-flex; align-items: center; gap: 4px;
    height: 30px; cursor: pointer;
  }
  .sc-mm-theme-toggle svg {
    width: 22px; height: 22px; padding: 4px;
    border-radius: 50%;
    color: var(--color-main, #1a1a1a);
  }
  /* Highlight active mode icon */
  :root:not([data-color-scheme="dark"]) .sc-mm-theme-toggle .gh-moon { opacity: 0.5; }
  :root[data-color-scheme="dark"] .sc-mm-theme-toggle .gh-sun  { opacity: 0.5; }
  :root:not([data-color-scheme="dark"]) .sc-mm-theme-toggle .gh-sun {
    background: #2b2b2b; color: #fff;
  }
  :root[data-color-scheme="dark"] .sc-mm-theme-toggle .gh-moon {
    background: #ffffff; color: #1a1a1a;
  }

  .sc-mm-ctas {
    display: flex; flex-direction: column; gap: 10px;
    padding: 24px 20px 8px;
  }
  .sc-mm-cta {
    display: block; text-align: center;
    padding: 14px 16px; border-radius: 10px;
    font-size: 15px; font-weight: 600; text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .sc-mm-cta--ghost {
    background: #1d2a3a; color: #fff;
  }
  .sc-mm-cta--filled {
    background: var(--sc-accent, #f18f20); color: #fff;
  }
  .sc-mm-cta:hover { opacity: 0.92; }
  [data-color-scheme="dark"] .sc-mm-cta--ghost {
    background: #2b2b2b; color: #fff;
  }

  .sc-mm-members {
    display: flex; flex-direction: column; gap: 8px;
    padding: 4px 20px 0;
  }
  .sc-mm-signin {
    text-align: center; padding: 10px;
    color: var(--color-main, #1a1a1a); text-decoration: none;
    font-size: 14px;
  }
  .sc-mm-join {
    text-align: center; padding: 12px;
    border-radius: 10px;
    background: transparent; color: var(--sc-accent, #f18f20);
    border: 1px solid var(--sc-accent, #f18f20);
    text-decoration: none; font-weight: 500;
  }

  .sc-mm-socials {
    list-style: none; padding: 20px 20px 0; margin: 0;
    display: flex; gap: 10px; justify-content: center; align-items: center;
    flex-wrap: wrap;
  }
  .sc-mm-socials li a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px;
  }

  .sc-mm-copy {
    padding: 20px; text-align: center; font-size: 12px;
    color: var(--sc-text-muted, #888);
    display: flex; flex-direction: column; gap: 2px;
    margin: 0;
  }

  /* Dark mode tweaks */
  [data-color-scheme="dark"] .sc-mm-header { background: #0a0a0a; }
  [data-color-scheme="dark"] .sc-mm-item { border-bottom-color: #1f1f1f; }
  [data-color-scheme="dark"] .sc-mm-sublist li { border-top-color: #1f1f1f; }
  [data-color-scheme="dark"] .sc-mm-has-sub[data-sc-mm-accordion].is-open > .sc-mm-link-btn {
    background: rgba(241, 143, 32, 0.1);
  }
</style>

<script>
  (function () {
    // Accordion behaviour for items with sub-menus.
    document.querySelectorAll('[data-sc-mm-accordion]').forEach(function (item) {
      var btn = item.querySelector('.sc-mm-link-btn');
      if (!btn) return;
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        var open = item.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    });
  })();
</script>
