<section class="sc-jobs">
    <div class="sc-jobs-inner">
        <div class="sc-jobs-top">
            <h2 class="sc-jobs-title">{{t "Crypto Jobs"}}</h2>
            <div class="sc-jobs-controls">
                <div class="sc-jobs-search">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M7.66732 14.0002C11.1651 14.0002 14.0007 11.1646 14.0007 7.66683C14.0007 4.16903 11.1651 1.3335 7.66732 1.3335C4.16951 1.3335 1.33398 4.16903 1.33398 7.66683C1.33398 11.1646 4.16951 14.0002 7.66732 14.0002Z" stroke="var(--color-muted-legacy)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M14.6673 14.6668L13.334 13.3335" stroke="var(--color-muted-legacy)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <input type="text" class="sc-jobs-search-input" placeholder="{{t "Search"}}" aria-label="{{t "Search jobs"}}">
                </div>
                <div class="sc-jobs-sort-wrap">
                    <button type="button" class="sc-jobs-sort" id="sc-jobs-sort-btn" aria-haspopup="listbox" aria-expanded="false">
                        <span class="sc-jobs-sort-label">{{t "Sort"}}</span>
                        <svg width="14" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 15l5 5 5-5M7 9l5-5 5 5"/></svg>
                    </button>
                    <ul class="sc-jobs-sort-menu" id="sc-jobs-sort-menu" role="listbox" hidden>
                        <li role="option" data-sort="newest" class="is-active">{{t "Newest first"}}</li>
                        <li role="option" data-sort="oldest">{{t "Oldest first"}}</li>
                        <li role="option" data-sort="salary-high">{{t "Salary: high to low"}}</li>
                        <li role="option" data-sort="salary-low">{{t "Salary: low to high"}}</li>
                    </ul>
                </div>
                <button class="sc-jobs-filter-btn" aria-label="{{t "Filter"}}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M14.4193 9.83317C14.4193 10.4265 14.2593 10.9865 13.9659 11.4665C13.4193 12.3798 12.4126 12.9998 11.2526 12.9998C10.6259 12.9998 10.0393 12.8132 9.54594 12.4865C9.13261 12.2332 8.79261 11.8798 8.54594 11.4665C8.25261 10.9865 8.08594 10.4265 8.08594 9.83317C8.08594 8.0865 9.50594 6.6665 11.2526 6.6665C11.4926 6.6665 11.7259 6.69317 11.9459 6.7465C13.3659 7.05983 14.4193 8.3265 14.4193 9.83317Z" fill="#EBEFF2" stroke="#005F93" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M10.0195 9.83323L10.7995 10.6132L12.4862 9.05322" fill="#EBEFF2"/>
                        <path d="M10.0195 9.83323L10.7995 10.6132L12.4862 9.05322" stroke="#005F93" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M13.7937 2.68016V4.16016C13.7937 4.70016 13.4537 5.3735 13.1204 5.7135L11.947 6.74683C11.727 6.69349 11.4937 6.66683 11.2537 6.66683C9.50704 6.66683 8.08704 8.08683 8.08704 9.8335C8.08704 10.4268 8.2537 10.9868 8.54704 11.4668C8.7937 11.8802 9.1337 12.2335 9.54704 12.4868V12.7135C9.54704 13.1202 9.28035 13.6602 8.94035 13.8602L8.00037 14.4668C7.12703 15.0068 5.9137 14.4002 5.9137 13.3202V9.7535C5.9137 9.28017 5.64036 8.6735 5.3737 8.34017L2.81368 5.64683C2.48035 5.30683 2.20703 4.70017 2.20703 4.30017V2.74683C2.20703 1.94016 2.81371 1.3335 3.55371 1.3335H12.447C13.187 1.3335 13.7937 1.94016 13.7937 2.68016Z" stroke="#EBEFF2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            </div>
        </div>

        <div class="sc-jobs-chips" role="tablist" aria-label="{{t "Job categories"}}">
            <button type="button" class="sc-jobs-chip is-active" data-job-chip="all" role="tab" aria-selected="true">{{t "All"}}</button>
            <button type="button" class="sc-jobs-chip" data-job-chip="engineering" role="tab" aria-selected="false">{{t "Engineering"}}</button>
            <button type="button" class="sc-jobs-chip" data-job-chip="product" role="tab" aria-selected="false">{{t "Product"}}</button>
            <button type="button" class="sc-jobs-chip" data-job-chip="design" role="tab" aria-selected="false">{{t "Design"}}</button>
            <button type="button" class="sc-jobs-chip" data-job-chip="marketing" role="tab" aria-selected="false">{{t "Marketing"}}</button>
            <button type="button" class="sc-jobs-chip" data-job-chip="business-development" role="tab" aria-selected="false">{{t "Business Development"}}</button>
            <button type="button" class="sc-jobs-chip" data-job-chip="operations" role="tab" aria-selected="false">{{t "Operations"}}</button>
            <button type="button" class="sc-jobs-chip" data-job-chip="community" role="tab" aria-selected="false">{{t "Community"}}</button>
            <button type="button" class="sc-jobs-chip" data-job-chip="research" role="tab" aria-selected="false">{{t "Research"}}</button>
            <button type="button" class="sc-jobs-chip" data-job-chip="trading" role="tab" aria-selected="false">{{t "Trading"}}</button>
            <button type="button" class="sc-jobs-chip" data-job-chip="compliance" role="tab" aria-selected="false">{{t "Compliance"}}</button>
            <button type="button" class="sc-jobs-chip" data-job-chip="customer-support" role="tab" aria-selected="false">{{t "Customer Support"}}</button>
            <div class="sc-jobs-chips-fade" aria-hidden="true"></div>
        </div>

        <div class="sc-jobs-grid" id="sc-jobs-grid">
            {{#get "posts" filter="tag:{{@custom.jobs_source_tag}}" limit="6" include="authors,tags" order="published_at desc"}}
                {{#foreach posts}}
                <div class="sc-job-card-wrap"
                    data-job-slugs="{{#foreach tags visibility="all"}}{{slug}} {{/foreach}}"
                    data-job-title="{{title}}"
                    data-job-company="{{#primary_author}}{{name}}{{/primary_author}}"
                    data-job-sort="{{date published_at format='X'}}"
                    data-job-salary="{{#has tag="#salary-120k-plus"}}200{{else}}{{#has tag="#salary-90k-180k"}}135{{else}}{{#has tag="#salary-90k-120k"}}105{{else}}{{#has tag="#salary-60k-90k"}}75{{else}}{{#has tag="#salary-40k-60k"}}50{{else}}0{{/has}}{{/has}}{{/has}}{{/has}}{{/has}}">
                    {{> "job-card"}}
                </div>
                {{/foreach}}
            {{/get}}
        </div>
        <p class="sc-jobs-empty" id="sc-jobs-empty" hidden>{{t "No jobs match these filters."}}</p>
        <button type="button" class="sc-jobs-load-more-btn is-hidden">Load More</button>

        <div class="sc-jobs-load-more-wrap">
            <button class="sc-jobs-load-more-btn is-hidden" type="button">{{t "Load more"}}</button>
        </div>

        <div class="sc-jobs-cta">
            <div class="sc-jobs-cta-text">
                <h3>{{t "Post a Job Opening"}}</h3>
                <p>{{t "Find top talent in the crypto and blockchain space"}}</p>
            </div>
            {{#if @custom.jobs_source_tag}}
            <a class="sc-jobs-cta-btn" href="{{@site.url}}/tag/{{@custom.jobs_source_tag}}/">{{t "Post a Job"}}</a>
            {{else}}
            <a class="sc-jobs-cta-btn" href="{{@site.url}}/tag/jobs/">{{t "Post a Job"}}</a>
            {{/if}}
        </div>
    </div>
</section>

<style>
  /* Sort dropdown popover */
  .sc-jobs-sort-wrap { position: relative; }
  .sc-jobs-sort { cursor: pointer; }
  .sc-jobs-sort-menu {
    position: absolute; top: calc(100% + 6px); right: 0;
    min-width: 200px;
    background: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 8px; padding: 4px;
    list-style: none; margin: 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    z-index: 100;
  }
  .sc-jobs-sort-menu[hidden] { display: none !important; }
  .sc-jobs-sort-menu li {
    padding: 10px 12px; border-radius: 6px; cursor: pointer;
    font-size: 14px; color: #495057;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .sc-jobs-sort-menu li:hover { background: rgba(0, 0, 0, 0.04); color: #022538; }
  .sc-jobs-sort-menu li.is-active {
    background: rgba(241, 143, 32, 0.12);
    color: #F18F20; font-weight: 500;
  }
  /* Dark mode overrides */
  :root[data-color-scheme="dark"] .sc-jobs-sort-menu {
    background: #101010;
    border-color: #1B1B1B;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }
  :root[data-color-scheme="dark"] .sc-jobs-sort-menu li {
    color: #9FB0C2;
  }
  :root[data-color-scheme="dark"] .sc-jobs-sort-menu li:hover {
    background: rgba(255, 255, 255, 0.04);
    color: #EBEFF2;
  }
  :root[data-color-scheme="dark"] .sc-jobs-sort-menu li.is-active {
    background: rgba(241, 143, 32, 0.15);
    color: #F18F20;
  }

  /* Empty state */
  .sc-jobs-empty {
    grid-column: 1 / -1;
    text-align: center; padding: 32px 16px;
    color: var(--sc-text-muted, #999); font-size: 15px;
  }
  .sc-jobs-empty[hidden] { display: none !important; }

  /* Cards being hidden via filter — keep grid clean */
  .sc-job-card-wrap[data-hidden="1"] { display: none !important; }
</style>

<script>
  (function () {
    const grid = document.getElementById('sc-jobs-grid');
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll('.sc-job-card-wrap'));
    const chips = document.querySelectorAll('.sc-jobs-chip[data-job-chip]');
    const searchInput = document.querySelector('.sc-jobs-search-input');
    const sortBtn = document.getElementById('sc-jobs-sort-btn');
    const sortMenu = document.getElementById('sc-jobs-sort-menu');
    const sortLabel = sortBtn ? sortBtn.querySelector('.sc-jobs-sort-label') : null;
    const emptyEl = document.getElementById('sc-jobs-empty');

    const state = { chip: 'all', q: '', sort: 'newest' };

    function applyFiltersAndSort() {
      // 1. Filter
      let visible = cards.filter((card) => {
        const slugs = (card.dataset.jobSlugs || '').toLowerCase().split(/\s+/);
        const chipOk = state.chip === 'all' || slugs.includes(state.chip);
        if (!chipOk) return false;
        if (!state.q) return true;
        const haystack = [
          card.dataset.jobTitle || '',
          card.dataset.jobCompany || '',
          (card.textContent || '')
        ].join(' ').toLowerCase();
        return haystack.includes(state.q);
      });

      // 2. Sort
      visible.sort((a, b) => {
        const dateA = parseInt(a.dataset.jobSort || '0', 10);
        const dateB = parseInt(b.dataset.jobSort || '0', 10);
        const salA  = parseInt(a.dataset.jobSalary || '0', 10);
        const salB  = parseInt(b.dataset.jobSalary || '0', 10);
        switch (state.sort) {
          case 'oldest':      return dateA - dateB;
          case 'salary-high': return salB - salA || dateB - dateA;
          case 'salary-low':  return (salA || Infinity) - (salB || Infinity) || dateB - dateA;
          case 'newest':
          default:            return dateB - dateA;
        }
      });

      // 3. Apply: hide all, re-append visible in new order
      cards.forEach((c) => c.setAttribute('data-hidden', '1'));
      visible.forEach((c) => {
        c.removeAttribute('data-hidden');
        grid.appendChild(c);
      });

      if (emptyEl) emptyEl.hidden = visible.length > 0;
    }

    // Chip clicks
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => {
          c.classList.remove('is-active');
          c.setAttribute('aria-selected', 'false');
        });
        chip.classList.add('is-active');
        chip.setAttribute('aria-selected', 'true');
        state.chip = chip.dataset.jobChip || 'all';
        applyFiltersAndSort();
      });
    });

    // Search input (live, debounced lightly)
    if (searchInput) {
      let t;
      searchInput.addEventListener('input', () => {
        clearTimeout(t);
        t = setTimeout(() => {
          state.q = searchInput.value.trim().toLowerCase();
          applyFiltersAndSort();
        }, 120);
      });
    }

    // Sort menu
    if (sortBtn && sortMenu) {
      sortBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = sortMenu.hidden;
        sortMenu.hidden = !open;
        sortBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      sortMenu.querySelectorAll('li[data-sort]').forEach((li) => {
        li.addEventListener('click', () => {
          sortMenu.querySelectorAll('li').forEach((x) => x.classList.remove('is-active'));
          li.classList.add('is-active');
          state.sort = li.dataset.sort;
          if (sortLabel) sortLabel.textContent = li.textContent.trim();
          sortMenu.hidden = true;
          sortBtn.setAttribute('aria-expanded', 'false');
          applyFiltersAndSort();
        });
      });
      document.addEventListener('click', (e) => {
        if (!sortBtn.contains(e.target) && !sortMenu.contains(e.target)) {
          sortMenu.hidden = true;
          sortBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Initial sort to ensure newest first
    applyFiltersAndSort();
  })();
</script>
