<section class="sc-contact-hero sc-career-hero" aria-labelledby="sc-jobs-hero-title">
    <div class="sc-contact-hero-inner sc-career-hero-inner gh-container">
        <span class="sc-contact-hero-chip">{{t "Crypto Jobs"}}</span>
        <h1 id="sc-jobs-hero-title">{{title}}</h1>
        {{#if excerpt}}
        <p>{{excerpt}}</p>
        {{else}}
        <p>{{t "Explore exciting opportunities on a rapidly expanding crypto job board, where job seekers connect with top companies in the blockchain industry."}}</p>
        {{/if}}
    </div>
</section>

<main class="main flex-1 sc-jobs-page">
    {{> "crypto-jobs"}}
</main>
