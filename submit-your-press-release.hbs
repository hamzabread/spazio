{{!< default}}
<link rel="stylesheet" href="{{asset 'css/list-your-company-fix.css'}}" />

<section class="sc-form-page">
  <div class="sc-form-container">

    <!-- Header -->
    <header class="sc-form-header">
      <div class="sc-header-icon-event">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 22 22"
          fill="none"
        >
          <path
            d="M5 3H15L19 7V19H5V3Z"
            stroke="#00A63E"
            stroke-width="1.6"
            stroke-linejoin="round"
          />
          <path
            d="M15 3V7H19"
            stroke="#00A63E"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
          <path
            d="M8 12H14M8 15H12"
            stroke="#00A63E"
            stroke-width="1.5"
            stroke-linecap="round"
          />
          <path
            d="M8 9H10"
            stroke="#00A63E"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
      </div>
      <div class="sc-header-text">
        <h1>Submit a Press Release</h1>
        <p>Share your news with SpazioCrypto's global audience</p>
      </div>
    </header>

    <form id="sc-pr-form" class="sc-main-form" novalidate>

      <!-- Section: Press Release Content -->
      <div class="sc-form-section">
        <h2 class="sc-section-title">Press Release Content</h2>
        <div class="border"></div>
        <div class="sc-input-group margin-bottom">
          <label for="sc-pr-headline">Headline<span class="required">*</span></label>
          <input
            id="sc-pr-headline"
            name="headline"
            type="text"
            required
            placeholder="e.g. SpazioCrypto Launches AI-Powered Market Intelligence Suite"
          />
        </div>

        <div class="sc-input-group full-width margin-bottom">
          <label for="sc-pr-summary">Summary / Lead Paragraph<span class="required">*</span></label>
          <textarea
            id="sc-pr-summary"
            name="summary"
            maxlength="300"
            required
            placeholder="The opening paragraph — what's the news? Who does it affect and why does it matter?"
            data-counter-for="sc-pr-summary-count"
          ></textarea>
          <div
            class="sc-input-footer"
            style="display:flex;justify-content:space-between;align-items:center;width:100%;"
          >
            <span>Keep it concise — appears as the post excerpt.</span>
            <span class="char-count"><span id="sc-pr-summary-count">0</span> / 300</span>
          </div>
        </div>
        <div class="sc-input-group full-width">
          <label for="sc-pr-body">Full Press Release Body<span class="required">*</span></label>
          <textarea
            id="sc-pr-body"
            name="body"
            maxlength="5000"
            required
            placeholder="Paste or type the full press release content here. Markdown and links are supported…"
            data-counter-for="sc-pr-body-count"
          ></textarea>
          <div
            class="sc-input-footer"
            style="display:flex;justify-content:space-between;align-items:center;width:100%;"
          >
            <span>Minimum 300 words recommended</span>
            <span class="char-count"><span id="sc-pr-body-count">0</span> / 5000</span>
          </div>
        </div>
      </div>

      <div class="outer_padding">
        <div class="sc-form-row">
          <div class="sc-input-group">
            <label id="sc-pr-category-label">Categories<span class="required">*</span></label>
            <div class="sc-multi-select" id="sc-pr-category-wrap" data-name="categories">
              <button type="button" class="sc-multi-trigger" id="sc-pr-category-trigger"
                      aria-haspopup="listbox" aria-expanded="false" aria-labelledby="sc-pr-category-label">
                <span class="sc-multi-chips" id="sc-pr-category-chips">
                  <span class="sc-multi-placeholder">Select categories…</span>
                </span>
                <svg class="sc-multi-caret" width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="#6A7282" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <ul class="sc-multi-menu" id="sc-pr-category-menu" role="listbox" aria-multiselectable="true" hidden>
                <li role="option" data-value="Exchanges">Exchanges</li>
                <li role="option" data-value="Wallets">Wallets</li>
                <li role="option" data-value="Analytics">Analytics</li>
                <li role="option" data-value="DeFi Apps">DeFi Apps</li>
                <li role="option" data-value="On-Chain">On-Chain</li>
                <li role="option" data-value="AI">AI</li>
                <li role="option" data-value="NFT">NFT</li>
                <li role="option" data-value="News">News</li>
                <li role="option" data-value="Research">Research</li>
                <li role="option" data-value="Launchpads">Launchpads</li>
                <li role="option" data-value="Regulation">Regulation</li>
              </ul>
            </div>
          </div>
          <div class="sc-input-group">
            <label for="sc-pr-contact">Press contact email<span class="required">*</span></label>
            <input
              id="sc-pr-contact"
              name="contactEmail"
              type="email"
              autocomplete="email"
              placeholder="press@yourcompany.com"
              aria-describedby="sc-pr-contact-error"
            />
            <span id="sc-pr-contact-error" class="sc-field-error" hidden>Enter a valid email like name@company.com</span>
          </div>
        </div>
      </div>

      <!-- Section: Editorial Checklist -->
      <div class="sc-form-section">
        <h2 class="sc-section-title">Editorial Checklist</h2>
        <div class="border"></div>

        <div class="sc-checklist-container">
          <div class="sc-checklist-item" data-pr-check>
            <div class="sc-custom-checkbox checked">
              <svg class="tick-icon" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M10 3L4.5 8.5L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <p>Content is factual and not misleading</p>
          </div>
          <div class="sc-checklist-item" data-pr-check>
            <div class="sc-custom-checkbox checked">
              <svg class="tick-icon" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M10 3L4.5 8.5L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <p>No pump-and-dump or price prediction language</p>
          </div>
          <div class="sc-checklist-item" data-pr-check data-required-consent="authorized">
            <div class="sc-custom-checkbox">
              <svg class="tick-icon" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M10 3L4.5 8.5L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <p>I confirm I am authorized to submit on behalf of this company</p>
          </div>
          <div class="sc-checklist-item" data-pr-check data-required-consent="terms">
            <div class="sc-custom-checkbox">
              <svg class="tick-icon" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M10 3L4.5 8.5L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <p>I agree to SpazioCrypto's editorial standards and terms</p>
          </div>
        </div>
      </div>

      <!-- Inline status / errors -->
      <div id="sc-pr-status" class="sc-pr-status" role="status" aria-live="polite" hidden></div>

      <!-- Footer Buttons -->
      <footer class="sc-form-footer">
        <p class="terms">Free listing. Reviewed within 48h. <a href="#">Terms apply.</a></p>
        <div class="sc-btn-group">
          <button type="button" class="btn-secondary" id="sc-pr-draft">Save Draft</button>
          <button type="submit" class="btn-primary" id="sc-pr-submit">Submit Press Release →</button>
        </div>
      </footer>
    </form>
  </div>
</section>

<style>
  .sc-pr-status { margin: 12px 0; padding: 12px 16px; border-radius: 8px; font-size: 14px; }
  .sc-pr-status.is-success { background: rgba(40, 167, 69, 0.15); color: #28a745; border: 1px solid rgba(40, 167, 69, 0.4); }
  .sc-pr-status.is-error   { background: rgba(220, 53, 69, 0.15); color: #ef4a5d; border: 1px solid rgba(220, 53, 69, 0.4); }
  .sc-pr-status.is-loading { background: rgba(241, 143, 32, 0.15); color: var(--sc-accent); border: 1px solid rgba(241, 143, 32, 0.35); }
  #sc-pr-submit[disabled], #sc-pr-draft[disabled] { opacity: 0.6; cursor: not-allowed; }
  .sc-field-error { display: block; margin-top: 6px; color: #ef4a5d; font-size: 12.5px; }
  .sc-main-form input.is-invalid,
  .sc-main-form .sc-multi-trigger.is-invalid { border-color: #ef4a5d !important; }

  /* Multi-select — theme-aware (uses --sc-* vars from list-your-company-fix.css) */
  .sc-multi-select { position: relative; }
  .sc-multi-trigger {
    width: 100%; min-height: 46px; padding: 8px 36px 8px 12px;
    border-radius: 8px;
    border: 1px solid var(--sc-border);
    background: var(--sc-input-bg);
    color: var(--sc-text-main);
    display: flex; align-items: center; cursor: pointer; text-align: left;
    font-size: 15px;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .sc-multi-trigger:hover { border-color: var(--sc-accent); }
  .sc-multi-trigger:focus { outline: 2px solid var(--sc-accent); outline-offset: 1px; }
  .sc-multi-chips { display: flex; flex-wrap: wrap; gap: 6px; flex: 1; align-items: center; }
  .sc-multi-placeholder { color: var(--sc-text-muted); font-size: 15px; }
  .sc-multi-caret {
    position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
    transition: transform 0.2s ease;
    color: var(--sc-text-muted);
  }
  .sc-multi-caret path { stroke: currentColor; }
  .sc-multi-select.is-open .sc-multi-caret { transform: translateY(-50%) rotate(180deg); }
  .sc-multi-chip {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 6px 4px 10px;
    background: var(--sc-accent-soft);
    color: var(--sc-accent);
    border-radius: 999px; font-size: 13px; font-weight: 500;
    border: 1px solid rgba(241, 143, 32, 0.3);
  }
  [data-color-scheme="dark"] .sc-multi-chip {
    background: rgba(241, 143, 32, 0.15);
    border-color: rgba(241, 143, 32, 0.35);
  }
  .sc-multi-chip-remove {
    background: transparent; border: 0; padding: 0; margin: 0;
    cursor: pointer; color: inherit; line-height: 1;
    width: 18px; height: 18px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 16px;
  }
  .sc-multi-chip-remove:hover { background: rgba(241, 143, 32, 0.2); }
  .sc-multi-menu {
    position: absolute; top: calc(100% + 4px); left: 0; right: 0;
    background: var(--sc-card-bg);
    border: 1px solid var(--sc-border);
    border-radius: 8px;
    list-style: none; margin: 0; padding: 4px;
    max-height: 260px; overflow-y: auto;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    z-index: 50;
  }
  .sc-multi-menu li {
    padding: 10px 12px; border-radius: 6px; cursor: pointer;
    font-size: 14px; color: var(--sc-text-main); user-select: none;
    display: flex; align-items: center; gap: 8px;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .sc-multi-menu li:hover { background: var(--sc-input-bg); }
  .sc-multi-menu li.is-selected {
    background: var(--sc-accent-soft);
    color: var(--sc-accent); font-weight: 500;
  }
  [data-color-scheme="dark"] .sc-multi-menu li.is-selected {
    background: rgba(241, 143, 32, 0.15);
  }
  .sc-multi-menu li.is-selected::before { content: "✓"; font-weight: 700; }
  .sc-multi-menu li:not(.is-selected)::before { content: ""; width: 12px; }
  .sc-multi-menu::-webkit-scrollbar { width: 8px; }
  .sc-multi-menu::-webkit-scrollbar-thumb { background: var(--sc-border); border-radius: 4px; }
</style>

<script>
  (function () {
    const SUBMIT_ENDPOINT = window.SC_PR_SUBMIT_ENDPOINT || 'http://localhost:3001/submit-press-release';

    const form = document.getElementById('sc-pr-form');
    const status = document.getElementById('sc-pr-status');
    const submitBtn = document.getElementById('sc-pr-submit');
    const draftBtn = document.getElementById('sc-pr-draft');

    // Checklist toggle
    document.querySelectorAll('[data-pr-check]').forEach((item) => {
      item.addEventListener('click', () => {
        item.querySelector('.sc-custom-checkbox').classList.toggle('checked');
      });
    });

    // Live char counters
    document.querySelectorAll('textarea[data-counter-for]').forEach((ta) => {
      const counter = document.getElementById(ta.dataset.counterFor);
      const update = () => { counter.textContent = ta.value.length; };
      ta.addEventListener('input', update);
      update();
    });

    function showStatus(kind, message) {
      status.hidden = false;
      status.className = 'sc-pr-status is-' + kind;
      status.textContent = message;
    }

    function getConsent(key) {
      const item = document.querySelector('[data-required-consent="' + key + '"]');
      return item ? item.querySelector('.sc-custom-checkbox').classList.contains('checked') : false;
    }

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const emailField = document.getElementById('sc-pr-contact');
    const emailError = document.getElementById('sc-pr-contact-error');

    // ---- Multi-select category widget ----
    const multiWrap = document.getElementById('sc-pr-category-wrap');
    const multiTrigger = document.getElementById('sc-pr-category-trigger');
    const multiMenu = document.getElementById('sc-pr-category-menu');
    const multiChips = document.getElementById('sc-pr-category-chips');
    const selectedCategories = new Set();

    function renderChips() {
      multiChips.innerHTML = '';
      if (selectedCategories.size === 0) {
        const ph = document.createElement('span');
        ph.className = 'sc-multi-placeholder';
        ph.textContent = 'Select categories…';
        multiChips.appendChild(ph);
        return;
      }
      selectedCategories.forEach((val) => {
        const chip = document.createElement('span');
        chip.className = 'sc-multi-chip';
        chip.dataset.value = val;
        chip.textContent = val + ' ';
        const x = document.createElement('button');
        x.type = 'button';
        x.className = 'sc-multi-chip-remove';
        x.setAttribute('aria-label', 'Remove ' + val);
        x.textContent = '×';
        x.addEventListener('click', (ev) => {
          ev.stopPropagation();
          selectedCategories.delete(val);
          renderChips();
          syncMenuSelection();
        });
        chip.appendChild(x);
        multiChips.appendChild(chip);
      });
    }
    function syncMenuSelection() {
      multiMenu.querySelectorAll('li').forEach((li) => {
        li.classList.toggle('is-selected', selectedCategories.has(li.dataset.value));
      });
    }
    function openMenu() {
      multiMenu.hidden = false;
      multiWrap.classList.add('is-open');
      multiTrigger.setAttribute('aria-expanded', 'true');
    }
    function closeMenu() {
      multiMenu.hidden = true;
      multiWrap.classList.remove('is-open');
      multiTrigger.setAttribute('aria-expanded', 'false');
    }
    multiTrigger.addEventListener('click', () => {
      if (multiMenu.hidden) openMenu(); else closeMenu();
    });
    multiMenu.querySelectorAll('li').forEach((li) => {
      li.addEventListener('click', () => {
        const v = li.dataset.value;
        if (selectedCategories.has(v)) selectedCategories.delete(v);
        else selectedCategories.add(v);
        renderChips();
        syncMenuSelection();
        multiTrigger.classList.remove('is-invalid');
      });
    });
    document.addEventListener('click', (ev) => {
      if (!multiWrap.contains(ev.target)) closeMenu();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = {
        headline: form.headline.value.trim(),
        summary: form.summary.value.trim(),
        body: form.body.value.trim(),
        categories: Array.from(selectedCategories),
        contactEmail: form.contactEmail.value.trim(),
        consentAuthorized: getConsent('authorized'),
        consentTerms: getConsent('terms'),
      };

      // Validation runs ONLY on submit (per requirement)
      if (!data.headline || !data.summary || !data.body) {
        showStatus('error', 'Please fill in the headline, summary, and full body.');
        return;
      }
      if (data.categories.length === 0) {
        multiTrigger.classList.add('is-invalid');
        showStatus('error', 'Please select at least one category.');
        return;
      }
      multiTrigger.classList.remove('is-invalid');
      const emailOk = data.contactEmail && EMAIL_RE.test(data.contactEmail);
      emailField.classList.toggle('is-invalid', !emailOk);
      emailError.hidden = emailOk;
      if (!emailOk) {
        showStatus('error', 'Please enter a valid press contact email.');
        emailField.focus();
        return;
      }
      if (!data.consentAuthorized || !data.consentTerms) {
        showStatus('error', 'Tick the authorization and editorial terms checkboxes to proceed.');
        return;
      }

      submitBtn.disabled = true;
      draftBtn.disabled = true;
      showStatus('loading', 'Submitting…');

      try {
        const resp = await fetch(SUBMIT_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await resp.json().catch(() => ({}));
        if (!resp.ok || !json.ok) {
          throw new Error(json.error || ('Server returned ' + resp.status));
        }
        showStatus(
          'success',
          'Thanks! Your press release was submitted as a ' + (json.status || 'draft') + ' and will be reviewed within 48 hours.'
        );
        form.reset();
        selectedCategories.clear();
        renderChips();
        syncMenuSelection();
        emailField.classList.remove('is-invalid');
        emailError.hidden = true;
        document.querySelectorAll('textarea[data-counter-for]').forEach((ta) => {
          document.getElementById(ta.dataset.counterFor).textContent = '0';
        });
      } catch (err) {
        showStatus('error', err.message || 'Submission failed. Please try again.');
      } finally {
        submitBtn.disabled = false;
        draftBtn.disabled = false;
      }
    });
  })();
</script>
