{{!< default}}

{{#post}}
<main class="sc-adv-page sc-about-page-dynamic">

    {{!-- Hero - mirrors the About hero (breadcrumbs + chip + H1 + lede + socials + image) --}}
    <section class="sc-about-hero sc-adv-hero">
        <div class="sc-about-shell">
            <article class="sc-about-hero-card sc-about-hero-card-dynamic">
                <div class="sc-about-hero-copy">
                    {{> breadcrumbs breadcrumb_title=(t "Advertising")}}

                    <span class="sc-about-chip">{{t "Advertising"}}</span>

                    <h1 data-sc-adv-hero-h1>{{title}}</h1>

                    <p data-sc-adv-hero-p>{{t "Reach a globally connected, savvy audience that lives and breathes Web3. Spaziocrypto puts your brand in front of decision-makers across crypto, blockchain, and digital finance — through a trusted editorial environment built for clarity, credibility, and impact."}}</p>

                    <div class="sc-about-socials">
                        {{#if @site.facebook}}<a href="{{facebook_url}}" target="_blank" rel="noopener" aria-label="Facebook">{{> "icons/facebook"}}</a>{{/if}}
                        {{#if @custom.telegram_link}}<a href="{{@custom.telegram_link}}" target="_blank" rel="noopener" aria-label="Telegram">{{> "icons/telegram"}}</a>{{/if}}
                        {{#if @custom.google_news_link}}<a href="{{@custom.google_news_link}}" target="_blank" rel="noopener" aria-label="Google">{{> "icons/googlenews"}}</a>{{/if}}
                        {{#if @custom.insta_link}}<a href="{{@custom.insta_link}}" target="_blank" rel="noopener" aria-label="Instagram">{{> "icons/instagram"}}</a>{{/if}}
                        {{#if @site.twitter}}<a href="{{twitter_url}}" target="_blank" rel="noopener" aria-label="Twitter">{{> "icons/twitter"}}</a>{{/if}}
                    </div>
                </div>

                <div class="sc-about-hero-image-wrap">
                    {{#if feature_image}}
                        <img class="sc-about-hero-image" src="{{img_url feature_image size="xl"}}" alt="{{title}}" loading="lazy" />
                    {{else}}
                        <img class="sc-about-hero-image" src="{{asset 'imagesAndIcons/aboutustop.png'}}" alt="{{title}}" loading="lazy" />
                    {{/if}}
                </div>
            </article>
        </div>
    </section>

    {{!-- Real Reach: stats grid --}}
    <section class="sc-adv-stats">
        <div class="sc-about-shell">
            <div class="sc-adv-section-head">
                <span class="sc-adv-chip">{{t "By the numbers"}}</span>
                <h2>{{t "A Platform With"}} <span>{{t "Real Reach"}}</span></h2>
                <p>{{t "Audited metrics across our owned and partner channels — updated quarterly."}}</p>
            </div>
            <div class="sc-adv-stats-grid">
                <article class="sc-adv-stat-card">
                    <span class="sc-adv-stat-num">10k+</span>
                    <h3>{{t "Unique Users Monthly"}}</h3>
                    <p>{{t "Engaged crypto-native readers"}}</p>
                </article>
                <article class="sc-adv-stat-card">
                    <span class="sc-adv-stat-num">9</span>
                    <h3>{{t "Languages Published"}}</h3>
                    <p>{{t "Global editorial coverage"}}</p>
                </article>
                <article class="sc-adv-stat-card">
                    <span class="sc-adv-stat-num">10k+</span>
                    <h3>{{t "Newsletter Subscribers"}}</h3>
                    <p>{{t "Direct inbox delivery"}}</p>
                </article>
                <article class="sc-adv-stat-card">
                    <span class="sc-adv-stat-num">2x</span>
                    <h3>{{t "Reach"}}</h3>
                    <p>{{t "Ads shared across platforms"}}</p>
                </article>
            </div>
        </div>
    </section>

    {{!-- Advertising Services: 5 cards (2x2 + 1 wide bottom) --}}
    <section class="sc-adv-services">
        <div class="sc-about-shell">
            <div class="sc-adv-section-head sc-adv-section-head--centered">
                <span class="sc-adv-chip">{{t "What We Offer"}}</span>
                <h2>{{t "Advertising"}} <span>{{t "Services"}}</span></h2>
                <p>{{t "A full suite of paid placements and editorial collaborations — built for crypto, Web3, and DeFi brands."}}</p>
            </div>
            <div class="sc-adv-services-grid">
                <article class="sc-adv-service-card">
                    <span class="sc-adv-service-icon" aria-hidden="true">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F18F20" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                    </span>
                    <h3>{{t "Display Advertising"}}</h3>
                    <p>{{t "Boost your brand within the crypto & Web3 space with banners, native ads, and sponsored placements in a trusted editorial environment."}}</p>
                </article>

                <article class="sc-adv-service-card">
                    <span class="sc-adv-service-icon" aria-hidden="true">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F18F20" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
                    </span>
                    <h3>{{t "Press Releases"}}</h3>
                    <p>{{t "Distribute press releases on Spaziocrypto and partner outlets. Ideal for project launches, events, market insights, or educational content."}}</p>
                    <ul class="sc-adv-service-bullets">
                        <li><span class="sc-adv-bullet" aria-hidden="true"></span><span class="sc-adv-bullet-text">{{t "Featured on"}} <strong>{{t "European Blockchain Convention"}}</strong>, <strong>{{t "TechBullion"}}</strong>, <strong>{{t "Blockchain Week Rome"}}</strong>, <strong>{{t "ETHRome"}}</strong> &amp; {{t "more"}}</span></li>
                        <li><span class="sc-adv-bullet" aria-hidden="true"></span><span class="sc-adv-bullet-text">{{t "Boost visibility and referral traffic"}}</span></li>
                    </ul>
                </article>

                <article class="sc-adv-service-card">
                    <span class="sc-adv-service-icon" aria-hidden="true">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F18F20" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    </span>
                    <h3>{{t "Sponsored Posts"}}</h3>
                    <p>{{t "Reach a targeted, engaged audience with sponsored content published on Spaziocrypto, supported by in-depth analysis and distribution via social channels and aggregators."}}</p>
                    <ul class="sc-adv-service-bullets">
                        <li><span class="sc-adv-bullet" aria-hidden="true"></span><span class="sc-adv-bullet-text">{{t "Distributed on top of aggregators —"}} <strong>{{t "Cryptopanic"}}</strong>, <strong>{{t "Blockchair"}}</strong>, <strong>{{t "Blogarama"}}</strong>, <strong>{{t "Google News"}}</strong> &amp; {{t "more"}}</span></li>
                        <li><span class="sc-adv-bullet" aria-hidden="true"></span><span class="sc-adv-bullet-text">{{t "High engagement & credibility"}}</span></li>
                    </ul>
                </article>

                <article class="sc-adv-service-card">
                    <span class="sc-adv-service-icon" aria-hidden="true">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F18F20" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
                    </span>
                    <h3>{{t "Product Service / Review"}}</h3>
                    <p>{{t "Professional reviews of your product or service: exchanges, wallets, tokens, DeFi projects, NFT platforms — with focus on usability, value, and market positioning."}}</p>
                </article>

                <article class="sc-adv-service-card sc-adv-service-card--wide">
                    <span class="sc-adv-service-icon" aria-hidden="true">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F18F20" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                    </span>
                    <h3>{{t "Hire a Content Writer"}}</h3>
                    <p>{{t "Get high-quality, crypto-focused content written by experienced writers — articles, guides, SEO-optimized reports to maximize reach and impact."}}</p>
                </article>
            </div>
        </div>
    </section>

    {{!-- Get Started: Contact + Payment + How publishing works --}}
    <section class="sc-adv-cta">
        <div class="sc-about-shell">
            <div class="sc-adv-section-head sc-adv-section-head--centered">
                <span class="sc-adv-chip">{{t "Get Started"}}</span>
                <h2>{{t "Let's Get The"}} <span>{{t "Conversation Going"}}</span></h2>
                <p>{{t "Email us, choose your payment, and learn how publishing works — everything you need to launch a campaign in one place."}}</p>
            </div>

            <div class="sc-adv-cta-card">
                <div class="sc-adv-cta-grid">
                    <article class="sc-adv-cta-col sc-adv-cta-col--contact">
                        <span class="sc-adv-eyebrow">{{t "CONTACT"}}</span>
                        <h3>{{t "Reach our"}} <span>{{t "team directly"}}</span></h3>
                        <p>{{t "Whether it's a media buy, a sponsored post, or a custom partnership — drop us a line and we'll respond within one business day."}}</p>
                        <a class="sc-adv-contact-row" href="mailto:marketing@spaziocrypto.com">
                            <span class="sc-adv-contact-icon" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                            </span>
                            <span class="sc-adv-contact-meta">
                                <span class="sc-adv-contact-label">{{t "MARKETING"}}</span>
                                <span class="sc-adv-contact-value">marketing@spaziocrypto.com</span>
                            </span>
                            <span class="sc-adv-contact-arrow" aria-hidden="true">→</span>
                        </a>
                        <a class="sc-adv-contact-row" href="mailto:info@spaziocrypto.com">
                            <span class="sc-adv-contact-icon" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                            </span>
                            <span class="sc-adv-contact-meta">
                                <span class="sc-adv-contact-label">{{t "GENERAL"}}</span>
                                <span class="sc-adv-contact-value">info@spaziocrypto.com</span>
                            </span>
                            <span class="sc-adv-contact-arrow" aria-hidden="true">→</span>
                        </a>
                        <a class="sc-adv-cta-button" href="mailto:marketing@spaziocrypto.com">{{t "Request a Tailored Quote"}} →</a>
                    </article>

                    <article class="sc-adv-cta-col sc-adv-cta-col--payment">
                        <span class="sc-adv-eyebrow">{{t "PAYMENT METHODS"}}</span>
                        <h3>{{t "Pay"}} <span>{{t "your way"}}</span></h3>
                        <p>{{t "Crypto, fiat, or wire — we keep things flexible. Other options available on request."}}</p>
                        <div class="sc-adv-payment-grid">
                            <span class="sc-adv-payment-tile"><span class="sc-adv-payment-mark sc-adv-payment-mark--btc">₿</span>{{t "Bitcoin"}}</span>
                            <span class="sc-adv-payment-tile"><span class="sc-adv-payment-mark sc-adv-payment-mark--eth">Ξ</span>{{t "Ethereum"}}</span>
                            <span class="sc-adv-payment-tile"><span class="sc-adv-payment-mark sc-adv-payment-mark--usdt">₮</span>{{t "USDT"}}</span>
                            <span class="sc-adv-payment-tile"><span class="sc-adv-payment-mark sc-adv-payment-mark--paypal">P</span>{{t "PayPal"}}</span>
                            <span class="sc-adv-payment-tile sc-adv-payment-tile--wide"><span class="sc-adv-payment-mark sc-adv-payment-mark--bank">▭</span>{{t "Bank Transfer (SEPA / SWIFT)"}}</span>
                        </div>
                        <p class="sc-adv-payment-note">{{t "All invoices are processed securely. Crypto payments confirmed on-chain. Other methods available upon request."}}</p>
                    </article>
                </div>
            </div>

            <div class="sc-adv-publishing-card">
                <div class="sc-adv-publishing-head">
                    <h3>{{t "How publishing"}} <span>{{t "works"}}</span></h3>
                    <p>{{t "From submission to live in 48 hours — three simple, transparent steps."}}</p>
                </div>
                <div class="sc-adv-publishing-steps">
                    <article class="sc-adv-publishing-step">
                        <div class="sc-adv-step-head">
                            <span class="sc-adv-step-num">1</span>
                            <h4>{{t "Submit Original Content"}}</h4>
                        </div>
                        <span class="sc-adv-step-tag">{{t "Editorial Quality"}}</span>
                        <p>{{t "Your article must be entirely original, written by a human, and offer genuine value to our readers."}}</p>
                    </article>
                    <span class="sc-adv-publishing-arrow" aria-hidden="true">→</span>
                    <article class="sc-adv-publishing-step">
                        <div class="sc-adv-step-head">
                            <span class="sc-adv-step-num">2</span>
                            <h4>{{t "Editorial & Link Review"}}</h4>
                        </div>
                        <span class="sc-adv-step-tag">{{t "No-Follow Only"}}</span>
                        <p>{{t "We strictly allow only no-follow links. Anything irrelevant or spammy will be flagged and rejected."}}</p>
                    </article>
                    <span class="sc-adv-publishing-arrow" aria-hidden="true">→</span>
                    <article class="sc-adv-publishing-step">
                        <div class="sc-adv-step-head">
                            <span class="sc-adv-step-num">3</span>
                            <h4>{{t "Live in 48 Hours"}}</h4>
                        </div>
                        <span class="sc-adv-step-tag">{{t "Fast Turnaround"}}</span>
                        <p>{{t "Once payment is confirmed, your article is published within 48 hours — guaranteed exposure to our audience."}}</p>
                    </article>
                </div>
            </div>
        </div>
    </section>

    {{!-- Audience: Global Readership --}}
    <section class="sc-adv-audience">
        <div class="sc-about-shell">
            <div class="sc-adv-section-head sc-adv-section-head--centered">
                <span class="sc-adv-chip">{{t "Audience"}}</span>
                <h2>{{t "A Truly"}} <span>{{t "Global Readership"}}</span></h2>
                <p>{{t "A snapshot of who reads Spaziocrypto, where they're tuning in from, and how they engage. Updated quarterly via Plausible."}}</p>
            </div>

            <div class="sc-adv-audience-card">
                <div class="sc-adv-audience-stats">
                    <div class="sc-adv-audience-stat">
                        <span class="sc-adv-audience-num">1<span class="sc-adv-audience-num-suffix">k+</span></span>
                        <p>{{t "AVG. USERS / MO."}}</p>
                    </div>
                    <div class="sc-adv-audience-stat">
                        <span class="sc-adv-audience-num">15<span class="sc-adv-audience-num-suffix">k+</span></span>
                        <p>{{t "AVG. VIEWS / MO."}}</p>
                    </div>
                    <div class="sc-adv-audience-stat">
                        <span class="sc-adv-audience-num">10<span class="sc-adv-audience-num-suffix">k+</span></span>
                        <p>{{t "EMAIL SUBS"}}</p>
                    </div>
                    <div class="sc-adv-audience-stat">
                        <span class="sc-adv-audience-num">2.4</span>
                        <p>{{t "PAGES / VISIT"}}</p>
                    </div>
                    <div class="sc-adv-audience-stat">
                        <span class="sc-adv-audience-num">54.7<span class="sc-adv-audience-num-suffix">%</span></span>
                        <p>{{t "BOUNCE RATE"}}</p>
                    </div>
                    <div class="sc-adv-audience-stat">
                        <span class="sc-adv-audience-num">15<span class="sc-adv-audience-num-suffix">k+</span></span>
                        <p>{{t "SOCIAL FOLLOWERS"}}</p>
                    </div>
                </div>

                <div class="sc-adv-audience-grid">
                    <div class="sc-adv-demographics">
                        <span class="sc-adv-eyebrow">{{t "DEMOGRAPHICS"}}</span>
                        <h3>{{t "Who's reading"}}</h3>
                        <div class="sc-adv-demo-grid">
                            <div class="sc-adv-demo-item">
                                <div class="sc-adv-demo-circle" style="--pct: 58">
                                    <span>58%</span>
                                </div>
                                <p>{{t "Americas / Europe"}}</p>
                            </div>
                            <div class="sc-adv-demo-item">
                                <div class="sc-adv-demo-circle" style="--pct: 56">
                                    <span>56%</span>
                                </div>
                                <p>{{t "Ages 18-34"}}</p>
                            </div>
                            <div class="sc-adv-demo-item">
                                <div class="sc-adv-demo-circle" style="--pct: 73">
                                    <span>73%</span>
                                </div>
                                <p>{{t "Male"}}</p>
                            </div>
                            <div class="sc-adv-demo-item">
                                <div class="sc-adv-demo-circle" style="--pct: 56">
                                    <span>56%</span>
                                </div>
                                <p>{{t "Asian"}}</p>
                            </div>
                        </div>
                    </div>

                    <div class="sc-adv-countries">
                        <span class="sc-adv-eyebrow">{{t "TOP COUNTRIES"}}</span>
                        <h3>{{t "Where they're tuning in"}}</h3>
                        <ul class="sc-adv-countries-list">
                            <li><span class="sc-adv-country-flag">IT</span><span class="sc-adv-country-name">{{t "Italy"}}</span><span class="sc-adv-country-bar"><span style="--pct: 22.6"></span></span><span class="sc-adv-country-pct">22.6%</span></li>
                            <li><span class="sc-adv-country-flag">US</span><span class="sc-adv-country-name">{{t "USA"}}</span><span class="sc-adv-country-bar"><span style="--pct: 18.7"></span></span><span class="sc-adv-country-pct">18.7%</span></li>
                            <li><span class="sc-adv-country-flag">SG</span><span class="sc-adv-country-name">{{t "Singapore"}}</span><span class="sc-adv-country-bar"><span style="--pct: 11.5"></span></span><span class="sc-adv-country-pct">11.5%</span></li>
                            <li><span class="sc-adv-country-flag">IN</span><span class="sc-adv-country-name">{{t "India"}}</span><span class="sc-adv-country-bar"><span style="--pct: 5.6"></span></span><span class="sc-adv-country-pct">5.6%</span></li>
                            <li><span class="sc-adv-country-flag">PL</span><span class="sc-adv-country-name">{{t "Poland"}}</span><span class="sc-adv-country-bar"><span style="--pct: 4"></span></span><span class="sc-adv-country-pct">4%</span></li>
                            <li><span class="sc-adv-country-flag">DE</span><span class="sc-adv-country-name">{{t "Germany"}}</span><span class="sc-adv-country-bar"><span style="--pct: 3.7"></span></span><span class="sc-adv-country-pct">3.7%</span></li>
                            <li><span class="sc-adv-country-flag">FR</span><span class="sc-adv-country-name">{{t "France"}}</span><span class="sc-adv-country-bar"><span style="--pct: 3.5"></span></span><span class="sc-adv-country-pct">3.5%</span></li>
                            <li><span class="sc-adv-country-flag">GB</span><span class="sc-adv-country-name">{{t "United Kingdom"}}</span><span class="sc-adv-country-bar"><span style="--pct: 3"></span></span><span class="sc-adv-country-pct">3%</span></li>
                            <li><span class="sc-adv-country-flag">ID</span><span class="sc-adv-country-name">{{t "Indonesia"}}</span><span class="sc-adv-country-bar"><span style="--pct: 2.6"></span></span><span class="sc-adv-country-pct">2.6%</span></li>
                        </ul>
                    </div>
                </div>

                <div class="sc-adv-audience-foot">
                    <span class="sc-adv-audience-foot-status"><span class="sc-adv-status-dot" aria-hidden="true"></span>{{t "Data via Plausible · Updated April 2026"}}</span>
                    <span class="sc-adv-audience-foot-window">{{t "Last 90 days"}}</span>
                </div>
            </div>
        </div>
    </section>

    {{> "faq-section"}}

</main>

{{!-- Hidden source for optional dynamic hydration --}}
<template class="sc-adv-source">{{{content}}}</template>

{{> "never-miss"}}
{{> "subscribe-newsletter"}}
{{> "social-media-channels"}}
{{/post}}
