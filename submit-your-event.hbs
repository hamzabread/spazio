{{!< default}}
<link rel="stylesheet" href="{{asset 'css/list-your-company-fix.css'}}" />

<section class="sc-form-page">
  <div class="sc-form-container">

    <!-- Header -->
    <header class="sc-form-header">
      <div class="sc-header-icon-event">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 22 22"
          fill="none"
        >
          <path d="M17.5 4H4.5C3.11929 4 2 5.11929 2 6.5V17.5C2 18.8807 3.11929 20 4.5 20H17.5C18.8807 20 20 18.8807 20 17.5V6.5C20 5.11929 18.8807 4 17.5 4Z" stroke="#9810FA" stroke-width="1.6"/>
          <path d="M2 10H20" stroke="#9810FA" stroke-width="1.4"/>
          <path d="M7 1V6M15 1V6" stroke="#9810FA" stroke-width="1.6" stroke-linecap="round"/>
          <path opacity="0.5" d="M8.2 13H6.8C6.35817 13 6 13.3582 6 13.8V15.2C6 15.6418 6.35817 16 6.8 16H8.2C8.64183 16 9 15.6418 9 15.2V13.8C9 13.3582 8.64183 13 8.2 13Z" fill="#9810FA"/>
          <path opacity="0.5" d="M12.7 13H11.3C10.8582 13 10.5 13.3582 10.5 13.8V15.2C10.5 15.6418 10.8582 16 11.3 16H12.7C13.1418 16 13.5 15.6418 13.5 15.2V13.8C13.5 13.3582 13.1418 13 12.7 13Z" fill="#9810FA"/>
          <path opacity="0.5" d="M17.2 13H15.8C15.3582 13 15 13.3582 15 13.8V15.2C15 15.6418 15.3582 16 15.8 16H17.2C17.6418 16 18 15.6418 18 15.2V13.8C18 13.3582 17.6418 13 17.2 13Z" fill="#9810FA"/>
        </svg>
      </div>
      <div class="sc-header-text">
        <h1>Submit Your Event</h1>
        <p>Promote to 500K+ crypto readers worldwide</p>
      </div>
    </header>

    <form id="sc-ev-form" class="sc-main-form" novalidate>

      <div class="sc-form-section">
        <h2 class="sc-section-title">Event Details</h2>
        <div class="border"></div>

        <div class="sc-input-group margin-bottom">
          <label for="sc-ev-name">Event Name<span class="required">*</span></label>
          <input id="sc-ev-name" name="eventName" type="text" placeholder="e.g. Bitcoin 2026 Conference"/>
        </div>

        <div class="sc-form-row">
          <div class="sc-input-group">
            <label for="sc-ev-type">Event Type<span class="required">*</span></label>
            <select id="sc-ev-type" name="eventType" class="sc-ev-form-select" required>
              <option value="" disabled selected>Select event type…</option>
              <option value="Conference">Conference</option>
              <option value="Meetup">Meetup</option>
              <option value="Workshop">Workshop</option>
              <option value="Webinar">Webinar</option>
              <option value="Hackathon">Hackathon</option>
              <option value="Summit">Summit</option>
              <option value="AMA">AMA</option>
              <option value="Networking">Networking</option>
            </select>
          </div>
          <div class="sc-input-group">
            <label for="sc-ev-cat">Category<span class="required">*</span></label>
            <select id="sc-ev-cat" name="category" class="sc-ev-form-select" required>
              <option value="" disabled selected>Select category…</option>
              <option value="DeFi">DeFi</option>
              <option value="NFT">NFT</option>
              <option value="Layer 1">Layer 1</option>
              <option value="Layer 2">Layer 2</option>
              <option value="Web3">Web3</option>
              <option value="AI">AI</option>
              <option value="GameFi">GameFi</option>
              <option value="Trading">Trading</option>
              <option value="Regulation">Regulation</option>
              <option value="Bitcoin">Bitcoin</option>
              <option value="Ethereum">Ethereum</option>
            </select>
          </div>
        </div>

        <h2 class="sc-section-title">Date &amp; Location</h2>
        <div class="border"></div>

        <div class="sc-form-row three-col">
          <div class="sc-input-group">
            <label for="sc-ev-start">Start Date<span class="required">*</span></label>
            <input id="sc-ev-start" name="startDate" type="date"/>
          </div>
          <div class="sc-input-group">
            <label for="sc-ev-end">End Date</label>
            <input id="sc-ev-end" name="endDate" type="date"/>
          </div>
          <div class="sc-input-group">
            <label for="sc-ev-time">Time (UTC)</label>
            <input id="sc-ev-time" name="time" type="time" placeholder="HH:MM"/>
          </div>
        </div>

        <div class="sc-form-row">
          <div class="sc-input-group">
            <label for="sc-ev-venue">Venue / Platform<span class="required">*</span></label>
            <input id="sc-ev-venue" name="venue" type="text" placeholder="Miami Beach Convention Center / Zoom"/>
          </div>
          <div class="sc-input-group">
            <label for="sc-ev-city">City / Country<span class="required">*</span></label>
            <input id="sc-ev-city" name="cityCountry" type="text" placeholder="Miami, USA · or Online"/>
          </div>
        </div>

        <h2 class="sc-section-title">About the Event</h2>
        <div class="border"></div>

        <div class="sc-input-group full-width">
          <label for="sc-ev-desc">Event Description<span class="required">*</span></label>
          <textarea id="sc-ev-desc" name="description" maxlength="500" placeholder="What will attendees learn? Who should attend? What makes your event special?" data-counter-for="sc-ev-desc-count"></textarea>
          <div class="sc-input-footer" style="display:flex;justify-content:space-between;align-items:center;width:100%;">
            <span>2–4 sentences recommended</span>
            <span class="char-count"><span id="sc-ev-desc-count">0</span> / 500</span>
          </div>
        </div>
      </div>

      <div class="outer_padding">
        <div class="sc-form-row">
          <div class="sc-input-group">
            <label for="sc-ev-url">Event URL / Tickets<span class="required">*</span></label>
            <input id="sc-ev-url" name="eventUrl" type="url" placeholder="https://event-tickets.com"/>
          </div>
          <div class="sc-input-group">
            <label for="sc-ev-att">Expected Attendees</label>
            <input id="sc-ev-att" name="attendees" type="text" placeholder="e.g. 500+ attendees"/>
          </div>
        </div>
      </div>

      <!-- Section: Cover Image -->
      <div class="sc-form-section">
        <h2 class="sc-section-title">Cover Image</h2>
        <div class="border"></div>
        <div class="sc-upload-box" id="sc-ev-upload-box">
          <input type="file" id="sc-ev-cover" name="coverImage" accept="image/jpeg,image/png,image/webp" hidden/>
          <label for="sc-ev-cover" id="sc-ev-upload-label">
            <span class="sc-ev-upload-icon" aria-hidden="true">🎪</span>
            <p>Upload event banner or <span class="orange-text">browse</span></p>
            <span class="specs">JPG, PNG or WEBP · Max 5MB · Recommended 1200×630px</span>
          </label>
          <div class="sc-ev-upload-preview" id="sc-ev-upload-preview" hidden>
            <img id="sc-ev-upload-img" alt="Cover preview" />
            <div class="sc-ev-upload-meta">
              <span id="sc-ev-upload-filename"></span>
              <button type="button" class="sc-ev-upload-remove" id="sc-ev-upload-remove" aria-label="Remove cover image">× Remove</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Inline status -->
      <div id="sc-ev-status" class="sc-pr-status" role="status" aria-live="polite" hidden></div>

      <footer class="sc-form-footer">
        <p class="terms">Free listing. Reviewed within 48h. <a href="#">Terms apply.</a></p>
        <div class="sc-btn-group">
          <button type="button" class="btn-secondary" id="sc-ev-draft">Save Draft</button>
          <button type="submit" class="btn-primary" id="sc-ev-submit">Submit Event →</button>
        </div>
      </footer>
    </form>
  </div>
</section>

<style>
  .sc-pr-status { margin: 12px 0; padding: 12px 16px; border-radius: 8px; font-size: 14px; }
  .sc-pr-status.is-success { background: rgba(40, 167, 69, 0.15); color: #28a745; border: 1px solid rgba(40, 167, 69, 0.4); }
  .sc-pr-status.is-error   { background: rgba(220, 53, 69, 0.15); color: #ef4a5d; border: 1px solid rgba(220, 53, 69, 0.4); }
  .sc-pr-status.is-loading { background: rgba(241, 143, 32, 0.15); color: var(--sc-accent); border: 1px solid rgba(241, 143, 32, 0.35); }
  #sc-ev-submit[disabled], #sc-ev-draft[disabled] { opacity: 0.6; cursor: not-allowed; }
  .sc-main-form input.is-invalid,
  .sc-main-form select.is-invalid,
  .sc-main-form textarea.is-invalid { border-color: #ef4a5d !important; }

  /* Theme-aware select dropdown (matches inputs via --sc-* vars) */
  .sc-ev-form-select {
    width: 100%; padding: 12px 16px; border-radius: 8px;
    border: 1px solid var(--sc-border);
    background-color: var(--sc-input-bg);
    color: var(--sc-text-main);
    font-size: 15px; font-family: inherit;
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8' fill='none'><path d='M1 1l5 5 5-5' stroke='%23999' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat; background-position: right 14px center;
    padding-right: 36px;
    transition: border-color 0.15s ease;
    cursor: pointer;
  }
  .sc-ev-form-select:hover { border-color: var(--sc-accent); }
  .sc-ev-form-select:focus { outline: 2px solid var(--sc-accent); outline-offset: 1px; }
  /* Options drop down to native OS popup — color them for both themes */
  .sc-ev-form-select option {
    background-color: var(--sc-card-bg);
    color: var(--sc-text-main);
  }
  .sc-ev-form-select option:disabled { color: var(--sc-text-muted); }

  /* Cover upload preview */
  .sc-upload-box { position: relative; }
  .sc-upload-box.is-invalid { border-color: #ef4a5d; }
  .sc-ev-upload-preview:not([hidden]) {
    margin-top: 12px; display: flex; align-items: center; gap: 14px;
    padding: 10px;
    border: 1px solid var(--sc-border);
    border-radius: 10px;
    background: var(--sc-input-bg);
  }
  .sc-ev-upload-preview[hidden] { display: none !important; }
  .sc-ev-upload-preview img {
    width: 160px; height: 90px; object-fit: cover; border-radius: 6px; display: block;
    background: var(--sc-card-bg);
  }
  .sc-ev-upload-meta { display: flex; flex-direction: column; gap: 6px; }
  .sc-ev-upload-meta span { font-size: 13px; color: var(--sc-text-main); word-break: break-all; }
  .sc-ev-upload-remove {
    align-self: flex-start;
    background: transparent;
    border: 1px solid var(--sc-border);
    color: #ef4a5d;
    padding: 4px 10px; border-radius: 6px; cursor: pointer; font-size: 13px;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .sc-ev-upload-remove:hover {
    background: rgba(220, 53, 69, 0.1);
    border-color: rgba(220, 53, 69, 0.4);
  }
</style>

<script>
  (function () {
    const SUBMIT_ENDPOINT = window.SC_EV_SUBMIT_ENDPOINT || 'http://localhost:3001/submit-event';

    const form = document.getElementById('sc-ev-form');
    const status = document.getElementById('sc-ev-status');
    const submitBtn = document.getElementById('sc-ev-submit');
    const draftBtn = document.getElementById('sc-ev-draft');

    document.querySelectorAll('textarea[data-counter-for]').forEach((ta) => {
      const counter = document.getElementById(ta.dataset.counterFor);
      const update = () => { counter.textContent = ta.value.length; };
      ta.addEventListener('input', update);
      update();
    });

    // ---- Cover image upload preview ----
    const MAX_BYTES = 5 * 1024 * 1024; // 5 MB
    const coverInput = document.getElementById('sc-ev-cover');
    const uploadLabel = document.getElementById('sc-ev-upload-label');
    const previewBox = document.getElementById('sc-ev-upload-preview');
    const previewImg = document.getElementById('sc-ev-upload-img');
    const previewName = document.getElementById('sc-ev-upload-filename');
    const removeBtn = document.getElementById('sc-ev-upload-remove');

    coverInput.addEventListener('change', () => {
      const file = coverInput.files && coverInput.files[0];
      if (!file) return;
      if (file.size > MAX_BYTES) {
        showStatus('error', 'Image is larger than 5 MB. Please pick a smaller file.');
        coverInput.value = '';
        return;
      }
      const reader = new FileReader();
      reader.onload = (ev) => {
        previewImg.src = ev.target.result;
        previewName.textContent = file.name + ' · ' + Math.round(file.size / 1024) + ' KB';
        previewBox.hidden = false;
        uploadLabel.hidden = true;
      };
      reader.readAsDataURL(file);
    });
    removeBtn.addEventListener('click', () => {
      coverInput.value = '';
      previewBox.hidden = true;
      uploadLabel.hidden = false;
    });

    function showStatus(kind, message) {
      status.hidden = false;
      status.className = 'sc-pr-status is-' + kind;
      status.textContent = message;
    }

    function clearInvalid() {
      form.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearInvalid();
      const fd = new FormData(form);
      const data = Object.fromEntries(fd.entries());

      const required = ['eventName','eventType','category','startDate','venue','cityCountry','description','eventUrl'];
      const missing = required.filter((k) => !data[k] || !String(data[k]).trim());
      if (missing.length) {
        missing.forEach((k) => {
          const el = form.elements[k];
          if (el) el.classList.add('is-invalid');
        });
        showStatus('error', 'Please fill all required fields (highlighted in red).');
        return;
      }

      try {
        new URL(data.eventUrl);
      } catch {
        form.elements.eventUrl.classList.add('is-invalid');
        showStatus('error', 'Event URL must be a valid http(s):// link.');
        return;
      }

      submitBtn.disabled = true;
      draftBtn.disabled = true;
      showStatus('loading', 'Submitting…');

      try {
        // Use multipart/form-data so the cover image can be uploaded alongside the JSON-ish fields.
        // FormData includes the file automatically and lets the browser set the boundary header.
        const resp = await fetch(SUBMIT_ENDPOINT, {
          method: 'POST',
          body: fd,
        });
        const json = await resp.json().catch(() => ({}));
        if (!resp.ok || !json.ok) {
          throw new Error(json.error || ('Server returned ' + resp.status));
        }
        showStatus('success', 'Thanks! Your event was submitted as a ' + (json.status || 'draft') + ' and will be reviewed within 48 hours.');
        form.reset();
        document.querySelectorAll('textarea[data-counter-for]').forEach((ta) => {
          document.getElementById(ta.dataset.counterFor).textContent = '0';
        });
        previewBox.hidden = true;
        uploadLabel.hidden = false;
      } catch (err) {
        showStatus('error', err.message || 'Submission failed. Please try again.');
      } finally {
        submitBtn.disabled = false;
        draftBtn.disabled = false;
      }
    });
  })();
</script>
